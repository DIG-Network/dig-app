balance-known = Saldo: { $dig } $DIG · { $xch } XCH
rewards-refill-cadence = Pada tingkat pendanaan ini, sebuah cermin mencapai ambang klaim setiap { $days } hari.
rewards-status-not-distributing = Tidak mendistribusikan
rewards-status-never-ran = Belum pernah berjalan
