// FIXTURE for scripts/check-space-runs.py -- dig-app#204. NOT compiled.
//
// The NEGATIVE direction, and the more important half. #204 is explicit:
// "a lint proven only by the positive case will be switched off the first
// time it fires on valid code." Every construct below is correct and common
// in this workspace, and the guard MUST stay silent on all of it.
//
// Stored as `.rs.fixture` so rustfmt never rewrites the constructs being
// pinned -- notably the backslash continuations, which `cargo fmt` rejoining
// is one of the ways the real defect is created.

/// A CORRECT continuation. Thirteen spaces of source indentation sit on the
/// second line; rustc eats them along with the newline, so the value is
/// "hello world" and there is no run to find. A guard reading SOURCE lines
/// fires here -- that is the false positive this whole design exists to
/// avoid, and why the value is evaluated instead.
pub const CONTINUED: &str = "hello \
             world";

/// The same idiom over several lines and deeper indentation, as the real
/// codebase writes it.
pub const LONG_SENTENCE: &str = "a sentence long enough to wrap, which continues \
                                 across a second line and then \
                                 across a third, with no run anywhere in its value";

/// Three spaces: one BELOW the bound. Pinning a threshold from only one side
/// can confirm nothing but itself, so this asserts the guard does not creep
/// downward while `AT_THE_BOUND` in the corrupted fixture asserts four fires.
pub const BELOW_THE_BOUND: &str = "the string stops   working";

/// A deliberately indented multi-line literal: a usage banner whose output
/// lines really do begin with spaces. The runs here start a value line, so
/// they are layout rather than a torn sentence.
pub const USAGE: &str = "Usage: dig-app [OPTIONS]

Options:
    --version      Print the version
    --help         Print this help";

/// Column alignment: differing pads reaching one column is what tabulation
/// IS, and it is how every CLI banner in `examples/` prints.
fn banner() {
    println!("endpoint            {endpoint}");
    println!("peak_height         {:?}", peak);
    println!("lineage             {:?}", lineage);
}

/// A raw string cannot HAVE a lost continuation -- it has no escapes -- so a
/// run inside one was typed on purpose.
pub const RAW: &str = r"a raw string with a    deliberate run";

/// Quote-like characters that open nothing: a lifetime, a char literal, an
/// escaped quote, and a run living inside a comment rather than a literal.
pub fn tricky<'a>(s: &'a str) -> &'a str {
    let _quote = '"';
    let _escaped = "she said \"no\" and meant it; the escaped quotes must not end the literal here";
    // a comment with a    run in it is never scanned, because comments are
    // skipped structurally rather than by what they happen to say
    s
}
